CORS_ALLOWED_ORIGINS=http://localhost:3000,https://lumenbazaar-frontend.vercel.app
MCP_HOST=0.0.0.0
MCP_PORT=3001
MCP_PATH=/mcp
MCP_TRUST_PROXY=false
